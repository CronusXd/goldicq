<script>
var ShopLoading=false;
function DelProduct(name, value,obj)
{
   var vvv="";
   vvv=readProduct(name);
   vvv=vvv.replace(','+value,"");
   document.cookie = name + "=" + vvv;
   obj.remove();
   jQuery.ajax({url:"ajax/ShoppingCartajax.asp?del=1",success:function(result){
	if (result==""){
		jQuery("#ShopTotal").html("");
		 if (typeof(shopping) != "undefined")
	{
		DelShopGoods(value,0);
	}
		return;
	}
	var projson = eval('(' + result + ')');
	 jQuery("#ShopTotal").html(projson.TotalPrice+'&nbsp;'+projson.TotalCur);
	 if (typeof(shopping) != "undefined")
	{
		DelShopGoods(value,projson.TotalPrice);
	}
    }});
	showpronum(-1);
}
function showpronum(num){
	var pronum=Number(jQuery("#pronum").html());
	if (isNaN(pronum))
	{
		pronum=0;
	}
	pronum=pronum+Number(num);
	//console.log(pronum);
	if (pronum>0)
	{
		jQuery('#pronum').html(pronum);
		jQuery('#pronum').show();
	}
	else
	{
		jQuery('#pronum').html("");
		jQuery('#pronum').hide();
	}
}
function showshop(val){
jQuery(".shopcart").slideToggle('fast');
if (val==1){
	loadproduct('',0);
}
}

function loadproduct(proid,Quantity){
if (ShopLoading)
{
	return;
}
ShopLoading=true;
var ajaxurl="";
if (proid=="")
{
ajaxurl="ajax/ShoppingCartajax.asp";
var tab=document.getElementById("ShopTb");
	var allrows=tab.rows.length;
	for(var i=1;i<=allrows;i++){
		tab.deleteRow(0);
	}
	jQuery("#pronum").html("");
	jQuery('#pronum').hide();
}
else
{
ajaxurl="ajax/ShoppingCartajax.asp?Proid="+proid+"&Quantity="+Quantity;
}
jQuery.ajax({url:ajaxurl,success:function(result){
	if (result==""){
		ShopLoading=false;
		if (typeof(shopping) != "undefined" && typeof(CustCode) == "undefined")
	 {
		ChangeShopPrice(0);
	 }
		return;
	}
	var projson = eval('(' + result + ')');
	for( var attr=0;attr<projson.Products.length;attr++ ){
	 jQuery("#ShopTb").append('<tr class="Products"><td height="25" width="350" class="left10"><span class="style4">'+projson.Products[attr].GameName+' -- <font color="red">'+projson.Products[attr].ServerName+'</font> -- '+projson.Products[attr].UnitName+' <font color="red">X '+projson.Products[attr].Quantity+'</font></span></td><td width="100" class="style3" align="center">'+projson.Products[attr].Price+'&nbsp;'+projson.Products[attr].Currency+'</td><td width="50" align="center"><img src="files0/i10.gif" border="0" title="Remove the goods" style="cursor:pointer" onclick="DelProduct(\'0\',\''+projson.Products[attr].Action+'\',jQuery(this).parent().parent())"></td></tr>');
	 showpronum(1);
	}
	 jQuery("#ShopTotal").html(projson.TotalPrice+'&nbsp;'+projson.TotalCur)
	if (typeof(shopping) != "undefined" && typeof(CustCode) == "undefined")
	 {
		ChangeShopPrice(projson.TotalPrice);
	 }
	 ShopLoading=false;
    }});
}
jQuery(function () { 
loadproduct('',0);
});
</script>

